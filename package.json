{
  "name": "videoSensing",
  "version": "1.0.0",
  "author": "OpenBlock",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/openblock-plugin/videoSensing.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "npx openblock-registry-cli dev",
    "build": "npx openblock-registry-cli build",
    "build:obfuscate": "npx openblock-registry-cli build --obfuscate",
    "publish": "npx openblock-registry-cli publish",
    "publish:dry": "npx openblock-registry-cli publish --dry-run",
    "validate": "npx openblock-registry-cli validate",
    "i18n:update": "npx openblock-registry-cli i18n update",
    "lint": "eslint . --ext .js --fix"
  },
  "openblock": {
    "name": {
      "formatMessage": {
        "id": "videoSensing.name",
        "default": "Video Sensing"
      }
    },
    "extensionId": "videoSensing",
    "arch": [
      "*"
    ],
    "iconURL": "./assets/videoSensing.png",
    "description": {
      "formatMessage": {
        "id": "videoSensing.description",
        "default": "Sense motion with the camera."
      }
    },
    "internetConnectionRequired": false,
    "main": "./src/videoSensing.js",
    "translations": "./src/translations.js",
    "tags": [
      "scratch"
    ],
    "helpLink": "https://wiki.openblock.cc"
  },
  "devDependencies": {
    "eslint": "^5.3.0",
    "eslint-config-scratch": "^5.0.0",
    "husky": "^9.0.0"
  }
}
